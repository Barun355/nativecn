{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "nativecn Registry source: Components, Primitives, Theme, Blocks (copied into apps, never published)",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest && node --test --no-warnings \"scripts/registry/*.test.ts\"",
    "generate:preset-colors": "node --no-warnings scripts/generate-preset-colors.ts > presets/colors.generated.ts && prettier --write presets/colors.generated.ts",
    "build": "node --no-warnings scripts/registry/build.ts"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "expo": "catalog:",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "preset": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "shadcn": "4.21.1",
    "test-renderer": "catalog:",
    "typescript": "catalog:",
    "zustand": "^5.0.15"
  },
  "type": "module"
}
