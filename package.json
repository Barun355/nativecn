    "version-packages": "changeset version",
    "release": "turbo run build --filter=nativecn-cli && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  }
}
