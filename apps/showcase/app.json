{
  "expo": {
    "name": "nativecn",
    "slug": "nativecn-showcase",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nativecn",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/images/splash-icon-dark.png",
        "backgroundColor": "#0B0B0B"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.nativecn.showcase"
    },
    "android": {
      "package": "dev.nativecn.showcase",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0B0B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd21cb93-cc23-48d6-8961-6a7c11d8e265"
      }
    },
    "owner": "baruntiwary"
  }
}
